# Binge Buddy Environment Configuration Example
# Copy this file to a new file named '.env' and fill in your values.

# 1. Supabase Connection Credentials (Required for auth & cloud lists)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key...

# 2. TMDB API Key (Configures the global movie data service)
# If provided here, your friends won't have to enter their own TMDB API keys when using the website!
VITE_TMDB_API_KEY=your-tmdb-api-key-v3-auth
